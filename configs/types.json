{
    "Windows": {
        "APPDATA": [
            "%APPDATA%",
            "%USERPROFILE%/Application Data"
        ],
        "LOCALAPPDATA": [
            "%LOCALAPPDATA%",
            "%USERPROFILE%/Local Settings/Application Data"
        ],
        "LOCALAPPDATALOW": [
            "%USERPROFILE%/AppData/LocalLow",
            "%USERPROFILE%/Local Settings/Application Data"
        ],
        "MSIX": [
            "%LOCALAPPDATA%/Packages",
            "%USERPROFILE%/Local Settings/Application Data/Packages"
        ],
        "USERPROFILE": [
            "%USERPROFILE%"
        ],
        "COMMONAPPDATA": [
            "%PROGRAMDATA%",
            "%ALLUSERSPROFILE%/Application Data",
            "C:/ProgramData",
            "C:/Documents and Settings/All Users/Application Data"
        ],
        "LEGACY": [
            "%ProgramFiles%",
            "%ProgramFiles(x86)%",
            "C:/Program Files",
            "C:/Program Files (x86)",
            "C:/PROGRAMS",
            "C:/"
        ]
    },
    "Linux": {
        "HOME": [
            "$XDG_CONFIG_HOME",
            "~",
            "~/.config"
        ],
        "SNAP": [
            "~/snap"
        ],
        "FLATPAK": [
            "~/.var/app"
        ]
    },
    "BSD": {
        "HOME": [
            "$XDG_CONFIG_HOME",
            "~",
            "~/.config"
        ]
    }
}
